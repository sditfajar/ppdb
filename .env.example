# Supabase (Wajib)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your-publishable-key-here
# PENTING: Kunci secret server-only; jangan pernah di-commit atau diawali NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here

# Cloudflare Turnstile (Anti-Spam)
# Untuk development, gunakan dummy key Cloudflare: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# URL Kanonik Aplikasi
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron Job Authorization (Fase 6)
CRON_SECRET=development-cron-secret-change-in-production
